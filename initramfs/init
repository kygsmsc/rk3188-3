#!/bin/sh

# 挂载必要的虚拟文件系统
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

echo ">>> Initramfs: 开始检查 eMMC 分区..."

PART="/dev/mmcblk0p1"
ROOTFS_DEV="/dev/mmcblk0p1"

# 检查分区是否存在
if [ -b "$PART" ]; then
    echo ">>> 分区 $PART 已存在，跳过创建。"
else
    echo ">>> 分区 $PART 不存在，正在创建..."
    (
      echo n
      echo p
      echo 1
      echo 49152
      echo ""
      echo w
    ) | fdisk /dev/mmcblk0
    
    sync
    sleep 1
    echo ">>> 分区创建完成，重启系统..."
    reboot -f
fi

# 分区已存在，挂载根文件系统
echo ">>> 正在挂载根文件系统 $ROOTFS_DEV 到 /newroot..."
mkdir -p /newroot
mount -t ext4 "$ROOTFS_DEV" /newroot

if [ $? -ne 0 ]; then
    echo "!!! 挂载失败，进入恢复 Shell..."
    exec sh
fi

# 切换到真正的根文件系统
echo ">>> 挂载成功，切换到真正的根文件系统..."
exec switch_root /newroot /sbin/init
